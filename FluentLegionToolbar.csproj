<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion><RootNamespace>FluentLegionToolbar</RootNamespace>
<AssemblyName>FluentLegionToolbar</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
<ApplicationIcon>app.ico</ApplicationIcon>
<Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
<UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>false</SelfContained>
<Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Version>0.2.1</Version>
</PropertyGroup>
<ItemGroup><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
<PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" /><PackageReference Include="System.Management" Version="8.0.0" /><PackageReference Include="NAudio.Wasapi" Version="2.2.1" /></ItemGroup>
<ItemGroup>
<Content Include="app.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
<Content Include="tray-dark.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
<Content Include="tray-white.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
<Content Include="legion-logo.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
<Content Include="install-startup.ps1"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
<Content Include="uninstall-startup.ps1"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
</ItemGroup>
</Project>
